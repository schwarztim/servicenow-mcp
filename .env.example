# ServiceNow MCP Configuration

SERVICENOW_INSTANCE_URL=https://yourinstance.service-now.com

# ============================================================================
# AUTHENTICATION
# ============================================================================
#
# Hermes is the AUTHORITATIVE auth broker. When HERMES_URL + HERMES_CLIENT_TOKEN
# are both set, every request fetches its credential from Hermes and Hermes owns
# the full lifecycle (acquisition, refresh, autoReacquire, SSO reseed). There is
# NO silent fallback to embedded browser auth: if Hermes is configured but
# failing, auth FAILS LOUD (the server throws) unless SERVICENOW_LEGACY_AUTH=true.

# Hermes Auth Broker (authoritative when set)
# HERMES_URL=http://127.0.0.1:9876
# HERMES_CLIENT_TOKEN=
# HERMES_SERVICE=servicenow   # broker service name (default: servicenow)
# HERMES_SCHEME=session       # broker scheme (default: session)

# Escape hatch — permit the legacy embedded-browser / local-cookie fallback when
# Hermes is configured but failing. Default OFF. Not recommended.
# SERVICENOW_LEGACY_AUTH=true

# ----------------------------------------------------------------------------
# LEGACY auth methods (used only when Hermes is NOT configured, or when
# SERVICENOW_LEGACY_AUTH=true). Choose ONE:
#
# Legacy Option 1: Browser SSO — set instance URL, then use the auth_browser tool
#
# Legacy Option 2: Basic Auth (username/password)
# SERVICENOW_USERNAME=your-username
# SERVICENOW_PASSWORD=your-password
#
# Legacy Option 3: Session Token Auth (for GraphQL)
# SERVICENOW_SESSION_TOKEN=your-cookie-string
# SERVICENOW_USER_TOKEN=your-g_ck-token
